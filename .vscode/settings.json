{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },
  "eslint.validate": [
    "javascript",
    "typescript",
    "typescriptreact"
  ],
  "js/ts.tsdk.path": "./node_modules/typescript/lib",
  "js/ts.suggest.autoImports": true,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "files.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    "**/.output": true,
    "**/.vinxi": true,
    "**/dist": true,
    "**/.cache": true,
    "**/coverage": true,
    "**/.turbo": true
  },
  "search.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    "**/.output": true,
    "**/.vinxi": true,
    "**/dist": true,
    "**/*.lock": true,
    "**/routeTree.gen.ts": true,
    "**/*.png": true,
    "**/*.webp": true,
    "**/*.mp4": true
  },
  "files.watcherExclude": {
    "**/.git/**": true,
    "**/node_modules/**": true,
    "**/.output/**": true,
    "**/.vinxi/**": true,
    "**/dist/**": true,
    "**/.cache/**": true,
    "**/coverage/**": true,
    "**/.turbo/**": true,
    "**/public/assets/**/*.png": true,
    "**/public/assets/**/*.webp": true,
    "**/public/assets/**/*.mp4": true
  },
  "search.useIgnoreFiles": true,
  "editor.largeFileOptimizations": true,
  "editor.minimap.enabled": false,
  "editor.bracketPairColorization.enabled": true,
  "editor.linkedEditing": true,
  "editor.formatOnPaste": false,
  "editor.formatOnType": false,
  "git.autofetch": false,
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "typescript.tsserver.maxTsServerMemory": 3072,
  "cSpell.words": [
    "Bullets",
    "CCU",
    "Codex",
    "CSP",
    "DPR",
    "Eater",
    "ESLint",
    "FPS",
    "Framer",
    "Francez",
    "GPU",
    "Happy",
    "HiDPI",
    "HSTS",
    "JavaScript",
    "Lucide",
    "Marpuf",
    "Nitro",
    "njsproj",
    "ntvs",
    "OpenGraph",
    "PowerShell",
    "Prettier",
    "React",
    "Samuca",
    "Six",
    "SSR",
    "Syntax",
    "Tailwind",
    "TanStack",
    "Thugo",
    "Town",
    "TypeScript",
    "Vinxi",
    "Vite",
    "WebGL",
    "WebP",
    "Whirle",
    "Yuki",
    "Zark"
  ],
  "cSpell.enabled": true,
  "cSpell.enabledFileTypes": {
    "markdown": true,
    "plaintext": true,
    "javascript": false,
    "javascriptreact": false,
    "typescript": false,
    "typescriptreact": false,
    "json": false,
    "jsonc": false,
    "css": false,
    "scss": false,
    "less": false,
    "html": false,
    "yaml": false,
    "toml": false,
    "ignore": false,
    "git-commit": false
  },
  "cSpell.ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.output/**",
    "**/.vinxi/**",
    "**/.tanstack/**",
    "**/.git/**",
    "**/coverage/**",
    "bun.lock",
    "**/*lock.json",
    "src/routeTree.gen.ts"
  ]
}
