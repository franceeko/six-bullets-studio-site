{
  "name": "six-bullets-studio-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "npm run typecheck && vite build",
    "build:dev": "npm run typecheck && vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "node --experimental-strip-types --test tests/perf-profile.test.ts tests/site-assets.test.ts tests/security-headers.test.ts",
    "format:check": "prettier --check .",
    "check": "npm run verify:workspace && npm run check:syntax && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "dev:local": "vite dev --host 127.0.0.1 --port 4173",
    "check:fast": "npm run verify:workspace && npm run check:syntax && npm run lint && npm run typecheck && npm test",
    "verify:workspace": "node scripts/verify-workspace.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "audit": "npm audit --audit-level=high",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "cf:dev": "wrangler dev"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/inter-tight": "^5.2.7",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-start": "^1.168.26",
    "framer-motion": "^12.42.0",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tw-animate-css": "^1.3.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@eslint/js": "^9.32.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.16",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "allowScripts": {
    "workerd@1.20261001.1": true,
    "esbuild@0.28.1": true
  }
}
